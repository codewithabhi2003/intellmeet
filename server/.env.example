PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRE=7d
STORAGE_DIR=./storage

# --- AI keys ---
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# --- AI Models ---
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
LANGUAGE_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- WebRTC ---
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Limits ---
MAX_AUDIO_MB=25
MAX_AUDIO_MINUTES=180
SEARCH_MAX_QUERY_CHARS=500
SEARCH_MAX_SEGMENTS=12
SEARCH_MAX_CONTEXT_CHARS=12000
SEARCH_VECTOR_CANDIDATES=3000
ATLAS_VECTOR_INDEX=
AI_RATE_LIMIT_PER_MIN=20
AI_REQUEST_TIMEOUT_MS=60000

# --- Admin ---
ADMIN_EMAIL=admin@intellmeet.local
ADMIN_PASSWORD=change_me_now

# --- Uploads ---
MAX_UPLOAD_MB=200
MAX_AVATAR_MB=2

# --- Meetings ---
MAX_ROOM_PEERS=6
MAX_SEMINAR_ATTENDEES=15

# --- Search ---
SEARCH_MIN_SIMILARITY=0.55